local function readBooksData()
    local collected = {}
    local solutionOrder = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local shapeAttr = obj:GetAttribute("Shape") or obj:GetAttribute("shape")
            local numAttr = obj:GetAttribute("Number") or obj:GetAttribute("number")
            if shapeAttr and numAttr then
                collected[tostring(shapeAttr):lower()] = tonumber(numAttr) or numAttr
            end
            local orderAttr = obj:GetAttribute("Order") or obj:GetAttribute("order")
            if orderAttr then
                for _, s in ipairs(orderAttr) do
                    table.insert(solutionOrder, tostring(s):lower())
                end
            end
        end
    end
    return collected, solutionOrder
end

local codeOverlay = nil

local function ensureCodeOverlay()
    if codeOverlay and codeOverlay.Parent then return codeOverlay end
    codeOverlay = Instance.new("TextLabel")
    codeOverlay.Name = "SOTA_CodeOverlay"
    codeOverlay.Size = UDim2.new(0, 260, 0, 60)
    codeOverlay.Position = UDim2.new(0, 20, 0, 120)
    codeOverlay.BackgroundColor3 = Color3.fromRGB(15,15,20)
    codeOverlay.BackgroundTransparency = 0.15
    codeOverlay.TextColor3 = Color3.fromRGB(255,215,0)
    codeOverlay.Font = Enum.Font.GothamBlack
    codeOverlay.TextSize = 22
    codeOverlay.Text = "CODE: -----"
    codeOverlay.ZIndex = 20
    codeOverlay.Parent = ScreenGui
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,10); c.Parent = codeOverlay
    local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(255,215,0); s.Thickness = 2; s.Parent = codeOverlay
    return codeOverlay
end

local function updateCodeOverlay()
    if not S.ShowCode then
        if codeOverlay then codeOverlay.Visible = false end
        return
    end
    if not ScreenGui or not ScreenGui.Parent then return end
    local ov = ensureCodeOverlay()
    ov.Visible = true
    local collected, order = readBooksData()
    if #order > 0 and next(collected) then
        local code = ""
        for _, shapeKey in ipairs(order) do
            local num = collected[shapeKey]
            code = code .. (num and tostring(num) or "?")
        end
        ov.Text = "CODE: " .. code
    elseif next(collected) then
        local parts = {}
        for shape, num in pairs(collected) do
            table.insert(parts, shape .. "=" .. tostring(num))
        end
        ov.Text = "FOUND: " .. table.concat(parts, "  ")
    else
        ov.Text = "CODE: -----"
    end
end

