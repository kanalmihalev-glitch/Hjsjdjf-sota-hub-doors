    local fogEnd = 5000 - (density / 100) * 4950
    Lighting.FogStart = 0
    Lighting.FogEnd = math.max(50, fogEnd)
    S.FogApplied = true
end
local function setFogEnabled(s) S.FogEnabled = s; applyFog() end
