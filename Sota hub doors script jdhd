        lb.BackgroundTransparency = 1; lb.Text = text; lb.TextColor3 = C.text
        lb.Font = FONT_MED; lb.TextSize = 13
        lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 2; lb.Parent = row
        local vl = Instance.new("TextLabel")
        vl.Size = UDim2.new(0.3,0,0,18); vl.Position = UDim2.new(0.6,0,0,8)
        vl.BackgroundTransparency = 1; vl.Text = tostring(default)
        vl.TextColor3 = C.accent; vl.Font = FONT
        vl.TextSize = 13; vl.TextXAlignment = Enum.TextXAlignment.Right
        vl.ZIndex = 2; vl.Parent = row
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1,-28,0,6); bg.Position = UDim2.new(0,14,1,-20)
        bg.BackgroundColor3 = C.elemHover; bg.BackgroundTransparency = 0.1
        bg.BorderSizePixel = 0; bg.ZIndex = 2; bg.Parent = row
        local bC = Instance.new("UICorner"); bC.CornerRadius = UDim.new(1,0); bC.Parent = bg
        local rel = (default - min) / (max - min)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(rel,0,1,0); fill.BackgroundColor3 = C.accent
        fill.BorderSizePixel = 0; fill.ZIndex = 2; fill.Parent = bg
        local fC = Instance.new("UICorner"); fC.CornerRadius = UDim.new(1,0); fC.Parent = fill
        local kn = Instance.new("Frame")
        kn.Size = UDim2.new(0,14,0,14); kn.AnchorPoint = Vector2.new(0.5,0.5)
        kn.Position = UDim2.new(rel,0,0.5,0); kn.BackgroundColor3 = C.white
        kn.BorderSizePixel = 0; kn.ZIndex = 3; kn.Parent = bg
        local kC = Instance.new("UICorner"); kC.CornerRadius = UDim.new(1,0); kC.Parent = kn
        local kS = Instance.new("UIStroke"); kS.Color = C.accent
        kS.Thickness = 2; kS.Parent = kn
        local cl = Instance.new("TextButton")
        cl.Size = UDim2.new(1,20,3,0); cl.Position = UDim2.new(0,-10,0.5,-0.5)
        cl.BackgroundTransparency = 1; cl.Text = ""
        cl.ZIndex = 3; cl.Parent = bg
        local value = default
        local dragging = false
        local function setX(x)
            local r = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            value = math.floor(min + r * (max - min) + 0.5)
            vl.Text = tostring(value)
            fill.Size = UDim2.new(r,0,1,0)
            kn.Position = UDim2.new(r,0,0.5,0)
            if cb then pcall(cb, value) end
        end
        cl.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; setX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then setX(input.Position.X) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        return row
    end

    local function dropdown(parent, text, options, default, cb)
        local cont = Instance.new("Frame")
        cont.Size = UDim2.new(1,-6,0,42); cont.BackgroundColor3 = C.element
        cont.BackgroundTransparency = BtnAlpha; cont.BorderSizePixel = 0
        cont.ClipsDescendants = true; cont.ZIndex = 2; cont.Parent = parent
        local cor = Instance.new("UICorner"); cor.CornerRadius = UDim.new(0,RADIUS.btn); cor.Parent = cont
        local lb = Instance.new("TextLabel")
        lb.Size = UDim2.new(0.4,0,0,42); lb.Position = UDim2.new(0,14,0,0)
        lb.BackgroundTransparency = 1; lb.Text = text
        lb.TextColor3 = C.text; lb.Font = FONT_MED; lb.TextSize = 13
        lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 2; lb.Parent = cont
        local cur = default or options[1] or ""
        local vbtn = Instance.new("TextButton")
        vbtn.Size = UDim2.new(0.5,0,0,30); vbtn.Position = UDim2.new(0.48,0,0,6)
        vbtn.BackgroundColor3 = C.elemHover; vbtn.BackgroundTransparency = 0.1
        vbtn.Text = cur.."   V"; vbtn.TextColor3 = C.text
        vbtn.Font = FONT_SEMI; vbtn.TextSize = 12
        vbtn.AutoButtonColor = false; vbtn.BorderSizePixel = 0
        vbtn.ZIndex = 3; vbtn.Parent = cont
        local vbC = Instance.new("UICorner"); vbC.CornerRadius = UDim.new(0,8); vbC.Parent = vbtn
        local list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1,-20,0,0); list.Position = UDim2.new(0,10,0,42)
        list.BackgroundTransparency = 1; list.BorderSizePixel = 0
        list.ScrollBarThickness = 2; list.CanvasSize = UDim2.new(0,0,0,0)
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.ZIndex = 3; list.Parent = cont
        local lL = Instance.new("UIListLayout"); lL.Padding = UDim.new(0,4)
        lL.SortOrder = Enum.SortOrder.LayoutOrder; lL.Parent = list
        local isOpen = false
        local function setOpen(state)
            isOpen = state
            if state then
                list.Size = UDim2.new(1,-20,0,160)
                cont.Size = UDim2.new(1,-6,0,42+170)
                cont.ClipsDescendants = false
                vbtn.Text = cur.."   ^"
            else
                list.Size = UDim2.new(1,-20,0,0)
                cont.Size = UDim2.new(1,-6,0,42)
                cont.ClipsDescendants = true
                vbtn.Text = cur.."   V"
            end
        end
        for _, opt in ipairs(options) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1,-4,0,26); ob.BackgroundColor3 = C.elemHover
            ob.BackgroundTransparency = 0.2; ob.Text = opt
            ob.TextColor3 = C.text; ob.Font = FONT_MED; ob.TextSize = 12
            ob.AutoButtonColor = false; ob.BorderSizePixel = 0
            ob.ZIndex = 4; ob.Parent = list
            local obC = Instance.new("UICorner"); obC.CornerRadius = UDim.new(0,6); obC.Parent = ob
            ob.MouseButton1Click:Connect(function()
                cur = opt; setOpen(false)
                if cb then pcall(cb, opt) end
            end)
        end
        vbtn.MouseButton1Click:Connect(function() setOpen(not isOpen) end)
        return cont
    end

    local function button(parent, text, cb, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,-6,0,42); btn.BackgroundColor3 = color or C.accent
        btn.BackgroundTransparency = 0; btn.Text = text
        btn.TextColor3 = C.white; btn.Font = FONT
        btn.TextSize = 13; btn.AutoButtonColor = false
        btn.BorderSizePixel = 0; btn.ZIndex = 3; btn.Parent = parent
        local cor = Instance.new("UICorner"); cor.CornerRadius = UDim.new(0,RADIUS.btn); cor.Parent = btn
        btn.MouseButton1Click:Connect(function()
            if cb then pcall(cb) end
        end)
        return btn
    end

    local vBtn, vBar, mBtn, mBar, miBtn, miBar, sBtn, sBar
    local function activateTab(which)
        VIS.Visible  = (which=="V")
        MOV.Visible  = (which=="M")
        MISC.Visible = (which=="MI")
        SET.Visible  = (which=="S")
        local function st(b, bar, active)
            if active then
                TweenService:Create(b, TweenInfo.new(0.22), {BackgroundColor3 = C.elemHover}):Play()
                TweenService:Create(bar, TweenInfo.new(0.22), {Size = UDim2.new(0,3,0.5,0)}):Play()
                b.TextColor3 = C.text
            else
                TweenService:Create(b, TweenInfo.new(0.22), {BackgroundColor3 = C.element}):Play()
                TweenService:Create(bar, TweenInfo.new(0.22), {Size = UDim2.new(0,3,0,0)}):Play()
                b.TextColor3 = C.subtext
            end
        end
        st(vBtn, vBar, which=="V"); st(mBtn, mBar, which=="M")
        st(miBtn, miBar, which=="MI"); st(sBtn, sBar, which=="S")
    end
    vBtn, vBar = tabBtn(L("visuals"), 1, function() activateTab("V") end)
    mBtn, mBar = tabBtn(L("movement"), 2, function() activateTab("M") end)
    miBtn, miBar = tabBtn(L("misc"), 3, function() activateTab("MI") end)
    sBtn, sBar = tabBtn(L("settings"), 4, function() activateTab("S") end)
