local function applyFog()
    if not S.FogEnabled then
        if S.FogApplied then
            Lighting.FogStart = LIGHTING_SNAPSHOT.FogStart
            Lighting.FogEnd = LIGHTING_SNAPSHOT.FogEnd
            Lighting.FogColor = LIGHTING_SNAPSHOT.FogColor
