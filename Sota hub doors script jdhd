local function classify(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return nil end
    if isPlayerCharacter(obj) then return nil end
    local n = obj.Name:lower()
    if isExcluded(n) then return nil end

    if S.BooksESP then
        if isFigureBook(obj) then return "Books" end
    end

    if S.CoinsESP then
        for _, kw in ipairs(COIN_KW) do
            if has(n,kw) then
                if obj:IsA("BasePart") and not isVisibleCoin(obj) then return nil end
                return "Coins"
            end
        end
    end
    if S.KeysESP then
        for _, kw in ipairs(KEY_KW) do
            if has(n,kw) then return "Keys" end
        end
        if has(n,"key") and not has(n,"keys") and not has(n,"keyboard") then return "Keys" end
    end
    if S.EntitiesESP then
        for _, kw in ipairs(ENTITY_KW) do
            if has(n,kw) then return "Entities" end
        end
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then return "Entities" end
    end
    if S.ItemsESP then
        for _, kw in ipairs(ITEM_KW) do
            if has(n,kw) then return "Items" end
        end
    end
    return nil
end

local function clearESPObject(obj)
    local d = ESPObjects[obj]
    if not d then return end
    pcall(function()
        if d.highlight then d.highlight:Destroy() end
        if d.billboard then d.billboard:Destroy() end
    end)
    ESPObjects[obj] = nil
end

local function addESPObject(obj, espType)
    if ESPObjects[obj] then return end
    local color = ESP_COLORS[espType] or Color3.fromRGB(255,255,255)
    local fillT = (espType=="Coins") and 0.15 or (espType=="Entities") and 0.5 or (espType=="Books") and 0.3 or 0.55
    local target = obj
    if obj:IsA("Model") then
        target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChildWhichIsA("MeshPart")
    end
    local displayText
    if espType == "Coins" then displayText = "Coin"
    elseif espType == "Books" then displayText = "Figure Book"
    else displayText = obj.Name end

    local ok = pcall(function()
        local hl = Instance.new("Highlight")
        hl.Name = "SOTA_ESP_HL"
        hl.FillColor = color
        hl.FillTransparency = fillT
        hl.OutlineColor = color
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = obj
        hl.Parent = obj

        local bb, label
        if target and target:IsA("BasePart") then
            bb = Instance.new("BillboardGui")
            bb.Name = "SOTA_ESP_BB"
            bb.Size = UDim2.new(0,80,0,14)
            bb.StudsOffset = Vector3.new(0,2,0)
            bb.AlwaysOnTop = true
            bb.Adornee = target
            bb.Enabled = true
            bb.Parent = target
            label = Instance.new("TextLabel")
            label.Size = UDim2.new(1,0,1,0)
            label.BackgroundTransparency = 1
            label.Text = displayText
            label.TextColor3 = color
            label.TextStrokeTransparency = 0.3
            label.TextStrokeColor3 = Color3.fromRGB(0,0,0)
            label.Font = Enum.Font.GothamBold
            label.TextSize = 10
            label.Parent = bb
        end
        ESPObjects[obj] = {type=espType, highlight=hl, billboard=bb, label=label}
    end)
    if not ok then clearESPObject(obj) end
end

local scanCooldown = 0
local currentList, currentIndex = nil, 1
local SCAN_BUDGET, SCAN_COOLDOWN = 1000, 0.4

local function getPlayerPos()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position or nil
end
local function inRange(obj)
    local p = getPlayerPos()
    if not p then return true end
    local pos
    if obj:IsA("BasePart") then pos = obj.Position
    elseif obj:IsA("Model") then
        local pr = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChildWhichIsA("MeshPart")
        pos = pr and pr.Position or nil
    end
    if not pos then return false end
    return (pos - p).Magnitude <= S.ESPRange
end

local function startScan()
    currentList = Workspace:GetDescendants()
    currentIndex = 1
end

Workspace.DescendantAdded:Connect(function(obj)
    if not obj or not obj.Parent then return end
    task.defer(function()
        if not obj.Parent then return end
        local t = classify(obj)
        if t and not ESPObjects[obj] and inRange(obj) then addESPObject(obj, t) end
    end)
end)

RunService.Heartbeat:Connect(function(dt)
    if currentList then
        local processed = 0
        while currentIndex <= #currentList and processed < SCAN_BUDGET do
            local obj = currentList[currentIndex]
            currentIndex = currentIndex + 1
            processed = processed + 1
            if obj and obj.Parent and not ESPObjects[obj] and inRange(obj) then
                local t = classify(obj)
                if t then addESPObject(obj, t) end
            end
        end
        if currentIndex > #currentList then
            currentList = nil
            currentIndex = 1
            scanCooldown = SCAN_COOLDOWN
        end
        return
    end
    local count = 0
    for obj, d in pairs(ESPObjects) do
        count = count + 1
