local function has(n,w) return n:find(w,1,true) ~= nil end
local function isExcluded(n)
    for _, w in ipairs(EXCLUDED) do
        if has(n,w) then return true end
    end
    return false
end
local function isPlayerCharacter(obj)
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char and (obj == char or obj:IsDescendantOf(char)) then return true end
    end
    return false
end
local function isVisibleCoin(obj)
    if obj:IsA("BasePart") then
        if obj.Transparency >= 1 then return false end
        if obj.Size.Magnitude < 0.1 then return false end
    end
    return obj.Parent ~= nil
end

local function isFigureBook(obj)
    if not obj:IsA("BasePart") then return false end
    local n = obj.Name:lower()
    if not (n:find("book", 1, true) or n:find("page", 1, true) or n:find("paper", 1, true) or n:find("code", 1, true)) then
        return false
    end
    local hasShape = obj:GetAttribute("Shape") or obj:GetAttribute("shape")
    local hasNumber = obj:GetAttribute("Number") or obj:GetAttribute("number")
    local hasOrder = obj:GetAttribute("Order") or obj:GetAttribute("order")
    if hasShape or hasNumber or hasOrder then return true end
    if n == "book" then return true end
    return false
end

