--=============================================================
-- POTATO GRAPHICS — TRUE potato (flat single-tone colors)
--=============================================================
-- Instead of removing colors, we FLATTEN every part to a single
-- solid tone of its hue — so a yellow part becomes pure flat yellow
-- (no shading, no material detail, no textures).
--=============================================================
local potatoSaved = {}       -- [Instance] = saved data
local potatoConns = {}
local potatoLightingSaved = nil
local potatoEffect = nil

local function isExempt(obj)
    if isPlayerCharacter(obj) then return true end
    if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then return true end
    if obj:IsA("GuiObject") or obj:IsA("ScreenGui") or obj:IsA("BillboardGui") then return true end
    return false
end

-- Boost a color to a saturated single-tone version (keeps hue, max vividness)
local function flattenColor(col)
    local h, s, v = Color3.toHSV(col)
    -- force saturation and value to high values to remove "shading"
    -- but keep hue identical
    local newS = math.clamp(s + 0.35, 0, 1)
    local newV = math.clamp(v + 0.1, 0.35, 1)
    return Color3.fromHSV(h, newS, newV)
end

local function potatoPart(part)
    if not part:IsA("BasePart") then return end
    if isExempt(part) then return end
    if not potatoSaved[part] then
        potatoSaved[part] = {
            Material = part.Material,
            Reflectance = part.Reflectance,
            Color = part.Color,
        }
    end
    pcall(function()
        part.Material = Enum.Material.Plastic
        part.Reflectance = 0
        part.Color = flattenColor(part.Color)
    end)
end

local function potatoDescendant(obj)
    if obj:IsA("BasePart") then
        potatoPart(obj)
    elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") then
        if obj.Parent and not isExempt(obj.Parent) then
            if not potatoSaved[obj] then
                potatoSaved[obj] = { Transparency = obj.Transparency }
            end
            pcall(function() obj.Transparency = 1 end)
        end
    end
end

local function applyPotato()
    if S.Potato then
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)

        -- save lighting once
        if not potatoLightingSaved then
            potatoLightingSaved = {
                GlobalShadows = Lighting.GlobalShadows,
                EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
                EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
                Brightness = Lighting.Brightness,
            }
        end
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
            Lighting.Brightness = math.max(2, Lighting.Brightness)
            -- do NOT touch Ambient / OutdoorAmbient / Fog — that caused green tint
        end)

        -- disable post-effects but remember state
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sky") then
                if not potatoSaved[obj] then
                    potatoSaved[obj] = { Enabled = obj.Enabled }
                end
                pcall(function() obj.Enabled = false end)
            end
        end

        -- Add ColorCorrectionEffect to boost flat colors
        if not potatoEffect or not potatoEffect.Parent then
            potatoEffect = Instance.new("ColorCorrectionEffect")
            potatoEffect.Name = "SOTA_PotatoCC"
            potatoEffect.Saturation = 0.5      -- vivid flat colors
            potatoEffect.Contrast = -0.3       -- remove shadows/detail
            potatoEffect.Brightness = 0.05
            potatoEffect.TintColor = Color3.fromRGB(255,255,255)
            potatoEffect.Parent = Lighting
        end

        -- flatten world
        for _, obj in ipairs(Workspace:GetDescendants()) do
            potatoDescendant(obj)
        end
        for _, c in ipairs(potatoConns) do c:Disconnect() end
        potatoConns = {}
        table.insert(potatoConns, Workspace.DescendantAdded:Connect(function(obj)
            if S.Potato then task.defer(function() potatoDescendant(obj) end) end
        end))
    else
        -- restore quality
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
        pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Automatic end)

        -- remove color correction
        if potatoEffect then
            pcall(function() potatoEffect:Destroy() end)
            potatoEffect = nil
        end

        -- restore lighting
        if potatoLightingSaved then
            pcall(function()
                Lighting.GlobalShadows = potatoLightingSaved.GlobalShadows
                Lighting.EnvironmentDiffuseScale = potatoLightingSaved.EnvironmentDiffuseScale
                Lighting.EnvironmentSpecularScale = potatoLightingSaved.EnvironmentSpecularScale
                Lighting.Brightness = potatoLightingSaved.Brightness
            end)
            potatoLightingSaved = nil
        end

        -- restore post-effects and every saved instance
        for _, c in ipairs(potatoConns) do c:Disconnect() end
        potatoConns = {}

        for inst, data in pairs(potatoSaved) do
            if inst and inst.Parent then
                pcall(function()
                    if data.Material then inst.Material = data.Material end
                    if data.Reflectance ~= nil then inst.Reflectance = data.Reflectance end
                    if data.Color then inst.Color = data.Color end
                    if data.Transparency ~= nil then inst.Transparency = data.Transparency end
                    if data.Enabled ~= nil then inst.Enabled = data.Enabled end
                end)
            end
        end
        potatoSaved = {}
    end
end

