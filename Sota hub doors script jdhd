local FOG_COLORS = {
    Gray    = Color3.fromRGB(120,120,120),
    Black   = Color3.fromRGB(20,20,20),
    White   = Color3.fromRGB(220,220,220),
    Red     = Color3.fromRGB(120,40,40),
